<UserControl
	x:Class="Files.App.UserControls.StatusBar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.App.Controls"
	xmlns:converters="using:Files.App.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:data="using:Files.App.Data.Items"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	xmlns:usercontrols="using:Files.App.UserControls"
	DataContext="{x:Bind StatusBarViewModel, Mode=OneWay}"
	SizeChanged="Content_SizeChanged"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Segmented/Segmented.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<converters:NullToTrueConverter x:Key="NullToFalseConverter" Inverse="True" />
			<converters:NullToVisibilityCollapsedConverter x:Key="NullToVisibilityCollapsedConverter" />
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid
		x:Name="RootGrid"
		MinHeight="32"
		Padding="8,0,8,0"
		BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
		BorderThickness="0,1,0,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<!--  Folder and selection info  -->
		<Grid
			x:Name="InfoArea"
			Grid.Column="0"
			Visibility="{x:Bind ShowInfoText, Mode=OneWay}">

			<StackPanel
				x:Name="InfoTextPanel"
				Height="32"
				HorizontalAlignment="Left"
				VerticalAlignment="Stretch"
				Orientation="Horizontal"
				SizeChanged="Content_SizeChanged"
				Spacing="8">

				<TextBlock
					x:Name="DirectoryItemCount"
					VerticalAlignment="Center"
					x:Load="{x:Bind ShowInfoText, Mode=OneWay}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="{x:Bind StatusBarViewModel.DirectoryItemCount, Mode=OneWay}" />

				<!--  Divider  -->
				<Border
					x:Name="SelectedItemsCountDivider"
					Width="1"
					Height="18"
					x:Load="{x:Bind SelectedItemsPropertiesViewModel.IsItemSelected, Mode=OneWay}"
					Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
				<!--  Selected Items Count  -->
				<TextBlock
					x:Name="SelectedItemsCountString"
					VerticalAlignment="Center"
					x:Load="{x:Bind SelectedItemsPropertiesViewModel.IsItemSelected, Mode=OneWay}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="{x:Bind SelectedItemsPropertiesViewModel.SelectedItemsCountString, Mode=OneWay}" />

				<!--  Divider  -->
				<Border
					x:Name="ItemSizeDivider"
					Width="1"
					Height="18"
					x:Load="{x:Bind SelectedItemsPropertiesViewModel.ItemSizeVisibility, Mode=OneWay}"
					Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
				<!--  Item Size  -->
				<TextBlock
					x:Name="ItemSize"
					VerticalAlignment="Center"
					x:Load="{x:Bind SelectedItemsPropertiesViewModel.ItemSizeVisibility, Mode=OneWay}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="{x:Bind SelectedItemsPropertiesViewModel.ItemSize, Mode=OneWay}" />
			</StackPanel>

			<!--  Compact stand-in for the folder and selection info  -->
			<Button
				x:Name="StatusButton"
				Height="24"
				Padding="8,0,8,0"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				AutomationProperties.Name="{helpers:ResourceString Name=Status}"
				Background="Transparent"
				BorderBrush="Transparent"
				ToolTipService.ToolTip="{helpers:ResourceString Name=Status}"
				Visibility="Collapsed">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<controls:ThemedIcon
						Width="16"
						Height="16"
						VerticalAlignment="Center"
						Style="{StaticResource App.ThemedIcons.Info}" />
					<TextBlock
						x:Name="StatusButtonLabel"
						VerticalAlignment="Center"
						Text="{helpers:ResourceString Name=Status}" />
				</StackPanel>

				<Button.Flyout>
					<Flyout Placement="Top">
						<StackPanel MinWidth="140" Spacing="8">
							<TextBlock Text="{x:Bind StatusBarViewModel.DirectoryItemCount, Mode=OneWay}" />

							<!--  Divider  -->
							<Border
								Height="1"
								HorizontalAlignment="Stretch"
								Background="{ThemeResource DividerStrokeColorDefaultBrush}"
								Visibility="{x:Bind ToVisibility(SelectedItemsPropertiesViewModel.IsItemSelected), Mode=OneWay, FallbackValue=Collapsed}" />
							<!--  Selected Items Count  -->
							<TextBlock Text="{x:Bind SelectedItemsPropertiesViewModel.SelectedItemsCountString, Mode=OneWay}" Visibility="{x:Bind ToVisibility(SelectedItemsPropertiesViewModel.IsItemSelected), Mode=OneWay, FallbackValue=Collapsed}" />

							<!--  Divider  -->
							<Border
								Height="1"
								HorizontalAlignment="Stretch"
								Background="{ThemeResource DividerStrokeColorDefaultBrush}"
								Visibility="{x:Bind ToVisibility(SelectedItemsPropertiesViewModel.ItemSizeVisibility), Mode=OneWay, FallbackValue=Collapsed}" />
							<!--  Item Size  -->
							<TextBlock Text="{x:Bind SelectedItemsPropertiesViewModel.ItemSize, Mode=OneWay}" Visibility="{x:Bind ToVisibility(SelectedItemsPropertiesViewModel.ItemSizeVisibility), Mode=OneWay, FallbackValue=Collapsed}" />
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>
		</Grid>

		<!--  Actions area, collapses into the Open in IDE button in the compact states  -->
		<StackPanel
			x:Name="StandardActions"
			Grid.Column="2"
			VerticalAlignment="Center"
			Orientation="Horizontal"
			SizeChanged="Content_SizeChanged">

			<!--  Divider  -->
			<Border
				x:Name="EncodingDivider"
				Width="1"
				Height="18"
				Margin="4,0,4,0"
				Background="{ThemeResource DividerStrokeColorDefaultBrush}"
				Visibility="{x:Bind GetEncodingDividerVisibility(StatusBarViewModel.IsZipEncodingSelectorVisible, StatusBarViewModel.ShowOpenInIDEButton), Mode=OneWay, FallbackValue=Collapsed}" />


			<!--  Divider  -->
			<Border
				x:Name="VSCodeDivider"
				Width="1"
				Height="18"
				Margin="4,0,0,0"
				Background="{ThemeResource DividerStrokeColorDefaultBrush}"
				Visibility="{x:Bind ToVisibility(StatusBarViewModel.ShowOpenInIDEButton), Mode=OneWay, FallbackValue=Collapsed}" />

			<!--  Open in IDE Button  -->
			<Button
				x:Name="OpenInIDEButton"
				Height="24"
				Margin="4,0,0,0"
				Padding="8,0,8,0"
				VerticalAlignment="Center"
				x:Load="{x:Bind StatusBarViewModel.ShowOpenInIDEButton, Mode=OneWay}"
				AutomationProperties.Name="{helpers:ResourceString Name=Open}"
				Background="Transparent"
				BorderBrush="Transparent">
				<Button.Content>
					<StackPanel Orientation="Horizontal" Spacing="8">
						<controls:ThemedIcon
							Width="16"
							Height="16"
							Style="{StaticResource App.ThemedIcons.Open}" />
						<TextBlock Text="{helpers:ResourceString Name=Open}" />
					</StackPanel>
				</Button.Content>

				<Button.Flyout>
					<MenuFlyout>
						<MenuFlyoutItem
							x:Name="OpenFolderInIDEButton"
							Command="{x:Bind Commands.OpenInIDE}"
							KeyboardAcceleratorTextOverride="{x:Bind Commands.OpenInIDE.HotKeys, Mode=OneWay}"
							Text="{x:Bind Commands.OpenInIDE.Label, Mode=OneWay}"
								ToolTipService.ToolTip="{x:Bind Commands.OpenInIDE.LabelWithHotKey, Mode=OneWay}" />
						</MenuFlyout>
				</Button.Flyout>
			</Button>
		</StackPanel>

		<!--  Compact stand-in for the actions area  -->
		<Grid
			x:Name="ActionsCompactArea"
			Grid.Column="3"
			Visibility="{x:Bind GetActionsAreaVisibility(StatusBarViewModel.ShowOpenInIDEButton), Mode=OneWay, FallbackValue=Collapsed}">

			<Button
				x:Name="GitOverflowButton"
				Height="24"
				Padding="8,0,8,0"
				VerticalAlignment="Center"
				AutomationProperties.Name="{helpers:ResourceString Name=Open}"
				Background="Transparent"
				BorderBrush="Transparent"
				ToolTipService.ToolTip="{helpers:ResourceString Name=Open}"
				Visibility="Collapsed">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<controls:ThemedIcon
						Width="16"
						Height="16"
						Style="{StaticResource App.ThemedIcons.Open}" />
					<TextBlock x:Name="GitOverflowButtonLabel" Text="{helpers:ResourceString Name=Open}" />
				</StackPanel>

				<Button.Flyout>
					<Flyout x:Name="ActionsOverflowFlyout" Placement="Top">
						<Flyout.FlyoutPresenterStyle>
							<Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
								<Setter Property="Padding" Value="8" />
							</Style>
						</Flyout.FlyoutPresenterStyle>
						<StackPanel MinWidth="220" Spacing="4">
							<StackPanel.Resources>
								<SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
								<SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
							</StackPanel.Resources>

							<!--  Open in IDE  -->
							<Button
								x:Name="OpenFolderInIDECompact"
								Height="32"
								Padding="8,0,8,0"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Background="Transparent"
								BorderBrush="Transparent"
								Command="{x:Bind Commands.OpenInIDE}"
								ToolTipService.ToolTip="{x:Bind Commands.OpenInIDE.LabelWithHotKey, Mode=OneWay}"
								Visibility="{x:Bind ToVisibility(StatusBarViewModel.ShowOpenInIDEButton), Mode=OneWay, FallbackValue=Collapsed}">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<controls:ThemedIcon
										Width="16"
										Height="16"
										Style="{StaticResource App.ThemedIcons.Open}" />
									<TextBlock Text="{x:Bind Commands.OpenInIDE.Label, Mode=OneWay}" />
								</StackPanel>
							</Button>
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>
		</Grid>

		<!--  ZIP Encoding Selector  -->
		<Grid
			x:Name="EncodingArea"
			Grid.Column="1"
			Visibility="{x:Bind StatusBarViewModel.IsZipEncodingSelectorVisible, Mode=OneWay}">
			<Button
				x:Name="ZipEncodingSelector"
				Height="24"
				Padding="8,0,8,0"
				VerticalAlignment="Center"
				Background="Transparent"
				BorderBrush="Transparent"
				SizeChanged="Content_SizeChanged"
				ToolTipService.ToolTip="{helpers:ResourceString Name=Encoding}">

				<StackPanel Orientation="Horizontal" Spacing="8">
					<FontIcon
						x:Name="ZipEncodingIcon"
						VerticalAlignment="Center"
						FontSize="14"
						Glyph="&#xE774;"
						Visibility="Collapsed" />
					<!--  Encoding Name  -->
					<TextBlock
						x:Name="ZipEncodingLabel"
						VerticalAlignment="Center"
						Text="{x:Bind StatusBarViewModel.SelectedZipEncoding.Name, Mode=OneWay, FallbackValue='', TargetNullValue=''}" />
				</StackPanel>

				<Button.Flyout>
					<Flyout x:Name="ZipEncodingFlyout" Opening="ZipEncodingFlyout_Opening">
						<Grid
							Width="240"
							Height="300"
							Margin="-16">

							<!--  Encodings List  -->
							<ListView
								x:Name="ZipEncodingList"
								Padding="4"
								Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								IsItemClickEnabled="True"
								ItemClick="ZipEncodingList_ItemClick"
								ItemsSource="{x:Bind StatusBarViewModel.ZipEncodingOptions, Mode=OneWay}"
								SelectedItem="{x:Bind StatusBarViewModel.SelectedZipEncoding, Mode=TwoWay}"
								SelectionMode="Single">

								<ListView.ItemTemplate>
									<DataTemplate x:DataType="data:EncodingItem">
										<TextBlock
											VerticalAlignment="Center"
											Text="{x:Bind Name}"
											TextTrimming="CharacterEllipsis" />
									</DataTemplate>
								</ListView.ItemTemplate>

							</ListView>
						</Grid>
					</Flyout>
				</Button.Flyout>
			</Button>
		</Grid>

		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="ResponsiveStates">
				<VisualState x:Name="NormalState" />
				<VisualState x:Name="CompactEncodingState">
					<VisualState.Setters>
						<Setter Target="ZipEncodingLabel.Visibility" Value="Collapsed" />
						<Setter Target="ZipEncodingIcon.Visibility" Value="Visible" />
					</VisualState.Setters>
				</VisualState>
				<VisualState x:Name="CompactActionsState">
					<VisualState.Setters>
						<Setter Target="ZipEncodingLabel.Visibility" Value="Collapsed" />
						<Setter Target="ZipEncodingIcon.Visibility" Value="Visible" />
						<Setter Target="StandardActions.Visibility" Value="Collapsed" />
						<Setter Target="GitOverflowButton.Visibility" Value="Visible" />
					</VisualState.Setters>
				</VisualState>
				<VisualState x:Name="CompactState">
					<VisualState.Setters>
						<Setter Target="ZipEncodingLabel.Visibility" Value="Collapsed" />
						<Setter Target="ZipEncodingIcon.Visibility" Value="Visible" />
						<Setter Target="StandardActions.Visibility" Value="Collapsed" />
						<Setter Target="GitOverflowButton.Visibility" Value="Visible" />
						<Setter Target="InfoTextPanel.Visibility" Value="Collapsed" />
						<Setter Target="StatusButton.Visibility" Value="Visible" />
					</VisualState.Setters>
				</VisualState>
				<VisualState x:Name="CompactIconsState">
					<VisualState.Setters>
						<Setter Target="ZipEncodingLabel.Visibility" Value="Collapsed" />
						<Setter Target="ZipEncodingIcon.Visibility" Value="Visible" />
						<Setter Target="StandardActions.Visibility" Value="Collapsed" />
						<Setter Target="GitOverflowButton.Visibility" Value="Visible" />
						<Setter Target="InfoTextPanel.Visibility" Value="Collapsed" />
						<Setter Target="StatusButton.Visibility" Value="Visible" />
						<Setter Target="StatusButtonLabel.Visibility" Value="Collapsed" />
						<Setter Target="GitOverflowButtonLabel.Visibility" Value="Collapsed" />
					</VisualState.Setters>
				</VisualState>
				<VisualState x:Name="MinimalState">
					<VisualState.Setters>
						<Setter Target="ZipEncodingSelector.Visibility" Value="Collapsed" />
						<Setter Target="StandardActions.Visibility" Value="Collapsed" />
						<Setter Target="GitOverflowButton.Visibility" Value="Visible" />
						<Setter Target="InfoTextPanel.Visibility" Value="Collapsed" />
						<Setter Target="StatusButton.Visibility" Value="Visible" />
						<Setter Target="StatusButtonLabel.Visibility" Value="Collapsed" />
						<Setter Target="GitOverflowButtonLabel.Visibility" Value="Collapsed" />
					</VisualState.Setters>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
	</Grid>
</UserControl>
